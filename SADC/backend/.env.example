# Copy this file to .env and fill it in. Never commit .env.

PORT=2001
# 127.0.0.1: only this machine can reach the backend (Caddy in front of it, and the Discord bot).
# Use 0.0.0.0 on hosts like Render that connect from outside.
HOST=127.0.0.1

# This backend's public address (no trailing slash). Discord sends people back to PUBLIC_URL/auth/discord/callback,
# so add exactly that under Developer Portal > your app > OAuth2 > Redirects.
PUBLIC_URL=https://sadc.87-76-169-31.sslip.io
# The website's address. People are sent back here after Discord sign-in, and only it may call the API.
FRONTEND_URL=http://localhost:2000
# Other sites allowed to call the API, comma separated (e.g. a Netlify preview address). Optional.
ALLOWED_ORIGINS=

# Shown in the message people sign with their wallet.
APP_NAME=TakeTheFloor

# Developer Portal > your app (the bot's app works) > OAuth2: Client ID and Client Secret.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Signs the website's sign-in tokens. 32+ random characters; changing it signs everyone out.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Shared with the Discord bot (SADC_BOT_SECRET in its .env), so only the bot can read the holder list.
# 16+ random characters, made the same way.
BOT_SECRET=

# A Solana RPC with the DAS API, e.g. Helius (free plan works): https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=
# The collection's address (the verified collection NFT, as shown on Magic Eden / Tensor / Solscan).
COLLECTION_ADDRESS=
COLLECTION_NAME=
# How many NFTs from the collection someone needs to get the role.
MIN_HOLD=1
# How often every linked wallet is checked again, so selling the NFT removes the role.
RECHECK_MINUTES=10

RATE_LIMIT_PER_MIN=60
# links.json is saved here.
DATA_DIR=data
